# Only needed for the live runs (scripts/run_extraction_eval.py, scripts/run_chat_eval.py).
ANTHROPIC_API_KEY=your-key-here

# AI disclosure (EU AI Act Art. 50) on the chat surface. Blank = the default ("I'm an AI assistant for {company}.").
AI_DISCLOSURE=
AI_DISCLOSURE_AR=
# Only switch it off on the client's written request, recorded here (date + who asked).
AI_DISCLOSURE_REMOVED_BY_WRITTEN_REQUEST=
